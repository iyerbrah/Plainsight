# Plainsight's settings. Copy this file to .env and fill it in:  cp .env.example .env
# .env is ignored by git, so the key never gets committed. Write values without quote marks.
# On the server the same names go in /opt/plainsight/.env.production instead.

# Who serves the model: openrouter or openai. Only that provider's key is needed.
LLM_PROVIDER=openrouter
# OpenRouter (openrouter.ai → Keys). The free model is rate-limited.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# OpenAI (platform.openai.com → API keys).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# How long the model thinks before writing the SQL: none, low, medium or high.
REASONING_EFFORT=low

# The site's public address, used in link previews. Optional; this is the default.
# SITE_URL=https://plainsight.ramiyer.tech

# Questions each visitor can ask in any rolling hour, and the whole site per UTC day.
RATE_LIMIT_PER_HOUR=20
DAILY_QUESTION_CAP=300
