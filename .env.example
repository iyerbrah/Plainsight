# Plainsight's settings. Copy this file to .env and fill it in:  cp .env.example .env
# .env is ignored by git, so the key never gets committed. Write values without quote marks.
# On the server the same names go in /opt/plainsight/.env.production instead.

# Your OpenAI API key, from platform.openai.com → API keys. Required.
OPENAI_API_KEY=

# Which OpenAI model writes the SQL, and how long it thinks first (none, low, medium or high).
LLM_MODEL=gpt-5.4-mini
REASONING_EFFORT=low

# Questions each visitor can ask in any rolling hour, and the whole site per UTC day.
RATE_LIMIT_PER_HOUR=20
DAILY_QUESTION_CAP=300
