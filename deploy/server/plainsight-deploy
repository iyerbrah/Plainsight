#!/bin/bash
# Deploys one commit of Plainsight's main branch on this server.
#
# Installed (root-owned) at /usr/local/sbin/plainsight-deploy by setup-github-deploy.sh.
# GitHub Actions runs it through the "plainsight-deploy" user's SSH key, which can run nothing else:
#
#   ssh plainsight-deploy@plainsight.ramiyer.tech <40-character commit SHA>
#
# It can also be run by hand on the server, e.g. to roll back:
#
#   sudo /usr/local/sbin/plainsight-deploy <commit SHA>
#
# The code comes from GitHub itself (the repo is public), and only commits that are on main are
# accepted. The Python packages are installed as the unprivileged "plainsight" user. This script
# does not update itself, the systemd unit or nginx: changes to those are applied by hand
# (see deploy/README.md).

set -euo pipefail

REPO_URL=https://github.com/iyerbrah/Plainsight.git
STATE=/var/lib/plainsight-deploy
SRC=$STATE/src
APP=/opt/plainsight
APP_HOME=/var/lib/plainsight
HEALTH=http://127.0.0.1:8100/healthz
SHA=${1:-}

if [[ ! $SHA =~ ^[0-9a-f]{40}$ ]]; then
  echo "Usage: plainsight-deploy <full 40-character commit SHA from main>" >&2
  exit 2
fi

# One deploy at a time.
exec 9>/run/lock/plainsight-deploy.lock
if ! flock -n 9; then
  echo "Another deploy is already running." >&2
  exit 1
fi

echo "→ Fetching $SHA from GitHub"
mkdir -p "$STATE"
if [[ ! -d $SRC/.git ]]; then
  git clone --quiet "$REPO_URL" "$SRC"
fi
git -C "$SRC" fetch --quiet --prune origin main
if ! git -C "$SRC" cat-file -e "$SHA^{commit}" 2>/dev/null; then
  echo "Commit $SHA isn't on GitHub." >&2
  exit 1
fi
if ! git -C "$SRC" merge-base --is-ancestor "$SHA" origin/main; then
  echo "Commit $SHA isn't on main, so it can't be deployed." >&2
  exit 1
fi
git -C "$SRC" checkout --quiet --force --detach "$SHA"
git -C "$SRC" clean --quiet -ffdx

echo "→ Copying it into $APP (secrets and the Python environment stay as they are)"
rsync -a --delete \
  --include=".env.example" --exclude=".env*" \
  --exclude=".venv" --exclude=".git" --exclude=".claude" --exclude="data/" \
  --exclude="__pycache__" --exclude=".pytest_cache" --exclude=".ruff_cache" \
  "$SRC/" "$APP/"
chown -R plainsight:plainsight "$APP"
install -d -o plainsight -g plainsight -m 750 "$APP_HOME"

as_app() { runuser -u plainsight -- env HOME="$APP_HOME" "$@"; }

echo "→ Installing Python packages as the plainsight user"
cd "$APP"
if [[ ! -x .venv/bin/python ]]; then
  as_app python3 -m venv .venv
fi
as_app .venv/bin/pip install --quiet --disable-pip-version-check -r requirements.txt

echo "→ Restarting the app"
systemctl restart plainsight
for _ in $(seq 1 30); do
  curl -fs -o /dev/null "$HEALTH" && break
  sleep 1
done
if ! curl -fsS -o /dev/null -w "→ App answered on the server: HTTP %{http_code}\n" "$HEALTH"; then
  echo "The app didn't come back after the restart. Its last log lines:" >&2
  journalctl -u plainsight -n 30 --no-pager >&2 || true
  exit 1
fi

echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $SHA" >> "$STATE/history"
echo "$SHA" > "$STATE/current"
echo "✓ Deployed $SHA"
