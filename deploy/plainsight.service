# Runs Plainsight as a background service that starts on boot and restarts if it crashes.
# deploy/deploy.sh installs this to /etc/systemd/system/plainsight.service; GitHub deploys don't touch it.
# Logs: journalctl -u plainsight -f

[Unit]
Description=Plainsight text-to-SQL site (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=plainsight
Group=plainsight
WorkingDirectory=/opt/plainsight
# LLM_PROVIDER, the provider keys and models, REASONING_EFFORT and the question limits. Only on the server;
# deploys never copy or overwrite it.
EnvironmentFile=/opt/plainsight/.env.production
# A few Python libraries write small files to HOME. ProtectHome hides /home, so HOME is the
# state folder systemd creates below (/var/lib/plainsight, owned by plainsight).
Environment=HOME=/var/lib/plainsight
StateDirectory=plainsight
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Only reachable from this machine; nginx forwards the public traffic. Port 8100 because
# QuoteRunner, on the same server, has 8000. One worker on purpose: the question limits are
# counted in the process's memory.
ExecStart=/opt/plainsight/.venv/bin/uvicorn web.main:app --host 127.0.0.1 --port 8100 --no-server-header
Restart=always
RestartSec=3

# Lock the process down: it can read the app (and the database, which it opens read-only)
# and write only its own state folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/plainsight
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
